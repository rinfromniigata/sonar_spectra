{
  "name": "sonar_spectra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "dev:pseudo": "tauri dev --config src-tauri/tauri.pseudo.conf.json",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "bun scripts/generate_icons.ts",
    "check": "bun run check:types && bun run check:lint && bun run check:i18n && bun run check:plist && bun run check:tokens && bun run check:unit && bun run check:rust",
    "check:types": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:lint": "eslint --max-warnings 0 .",
    "check:i18n": "bun scripts/i18n_check.ts",
    "check:plist": "bun scripts/info_plist_check.ts",
    "check:tokens": "bun scripts/token_check.ts",
    "check:unit": "vitest run",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/syncopate": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "vue": "^3.5.44",
    "vue-i18n": "~11.4"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5",
    "@intlify/message-compiler": "11.4.18",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.14",
    "eslint-plugin-vue": "^10.12",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72",
    "vite": "~8.3.5",
    "vitest": "^5.1",
    "vue-eslint-parser": "^10.4",
    "vue-tsc": "^3.3.14",
    "yaml-eslint-parser": "^2.1.0"
  }
}
